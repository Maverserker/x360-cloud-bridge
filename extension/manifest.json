{
  "manifest_version": 3,
  "name": "X360 Cloud Bridge",
  "version": "0.1.0",
  "description": "Use an Xbox 360 wireless controller (via its USB receiver) in Xbox Cloud Gaming and GeForce NOW on macOS.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "X360 Cloud Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.xbox.com/*",
        "https://play.geforcenow.com/*",
        "https://gamepad-tester.com/*",
        "https://hardwaretester.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.xbox.com/*",
        "https://play.geforcenow.com/*",
        "https://gamepad-tester.com/*",
        "https://hardwaretester.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["relay.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
